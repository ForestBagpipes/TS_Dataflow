% Fontmap: 把字体名映射到 TeX Live 自带的 URW 克隆字体。
%
% 背景：TeX Live 的 tlgs 未随包提供 Nimbus 字体，而其内置 Resource/Init/Fontmap.GS
% 会把 /Helvetica* 映射到 /NimbusSanL-*，找不到时 ghostscript 直接报
% "undefined in Helvetica-Bold"。这里补上 Nimbus 名字到 .pfb 文件的映射。
%
% 用法：把本目录加入 GS_LIB，并把 GS_FONTPATH 指向 texmf 的 urw/helvetic 目录。
/NimbusSanL-Regu      (uhvr8a.pfb) ;
/NimbusSanL-Bold      (uhvb8a.pfb) ;
/NimbusSanL-ReguItal  (uhvro8a.pfb) ;
/NimbusSanL-BoldItal  (uhvbo8a.pfb) ;
/Helvetica            (uhvr8a.pfb) ;
/Helvetica-Bold       (uhvb8a.pfb) ;
/Helvetica-Oblique    (uhvro8a.pfb) ;
/Helvetica-BoldOblique (uhvbo8a.pfb) ;
